# Server Configuration
NODE_ENV=production
PORT=8080
FRONTEND_URL=https://your-frontend-domain.azurewebsites.net

# Database (Use Azure Key Vault reference or App Settings)
MONGODB_URI=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/mongodb-uri/)

# JWT Secrets (Use Azure Key Vault)
JWT_SECRET=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/jwt-secret/)
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/jwt-refresh-secret/)
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/email-user/)
EMAIL_PASSWORD=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/email-password/)
EMAIL_FROM=HMS <noreply@yourdomain.com>

# Razorpay (Use Azure Key Vault)
RAZORPAY_KEY_ID=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/razorpay-key-id/)
RAZORPAY_KEY_SECRET=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/razorpay-key-secret/)
RAZORPAY_WEBHOOK_SECRET=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/razorpay-webhook-secret/)

# Cloudinary (Use Azure Key Vault)
CLOUDINARY_CLOUD_NAME=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/cloudinary-cloud-name/)
CLOUDINARY_API_KEY=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/cloudinary-api-key/)
CLOUDINARY_API_SECRET=@Microsoft.KeyVault(SecretUri=https://your-keyvault.vault.azure.net/secrets/cloudinary-api-secret/)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
